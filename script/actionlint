#!/usr/bin/env bash
set -euo pipefail
[[ "${GITHUB_ACTIONS:-}" == true && "${GITHUB_REPOSITORY:-}" == iret77/nexgenvideo ]]
case "${RUNNER_OS:-}/$(uname -m)" in
  Linux/x86_64) ;;
  macOS/arm64) sw_vers; test "$(sw_vers -productVersion | cut -d. -f1)" = 27 ;;
  *) exit 1 ;;
esac
actionlint_dir="$RUNNER_TEMP/ngv-actionlint-1.7.12"
mkdir "$actionlint_dir"
export GOTOOLCHAIN=local GOWORK=off CGO_ENABLED=0
(
  cd script/actionlint-tool
  python3 ../../scripts/isolated_test_home.py --home "$RUNNER_TEMP/actionlint-test-home" -- go test -count=1 -mod=readonly .
  go build -mod=readonly -trimpath -o "$actionlint_dir/actionlint" .
)
"$actionlint_dir/actionlint" -config-file .github/actionlint.yaml -shellcheck= -pyflakes= "$@"
