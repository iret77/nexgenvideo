#!/usr/bin/env bash
set -euo pipefail
[[ "${GITHUB_ACTIONS:-}" == true && "${GITHUB_REPOSITORY:-}" == iret77/nexgenvideo && "${RUNNER_OS:-}" == Linux ]]
[[ "$(uname -m)" == x86_64 ]]
actionlint_dir="$RUNNER_TEMP/ngv-actionlint-1.7.12"
mkdir "$actionlint_dir"
curl --fail --location --silent --show-error --max-time 60 \
  https://github.com/rhysd/actionlint/releases/download/v1.7.12/actionlint_1.7.12_linux_amd64.tar.gz \
  --output "$actionlint_dir/archive.tar.gz"
printf '%s  %s\n' 8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8 "$actionlint_dir/archive.tar.gz" | sha256sum --check
tar -xzf "$actionlint_dir/archive.tar.gz" -C "$actionlint_dir" actionlint
"$actionlint_dir/actionlint" -config-file .github/actionlint.yaml -shellcheck= -pyflakes= "$@"
