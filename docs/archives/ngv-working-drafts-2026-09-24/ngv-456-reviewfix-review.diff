+                        "arguments": inputJSON,
+                    ])
+                case .toolResult(let id, let blocks, let isError):
+                    guard message.role == .user else {
+                        throw CodexAppServerError.transcriptReplayUnavailable(
+                            "a host tool result has an invalid role"
+                        )
+                    }
