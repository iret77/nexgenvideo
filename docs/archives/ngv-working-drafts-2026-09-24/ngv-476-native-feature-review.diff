+            .interfaceFont(size: AppTheme.Typography.metadata)
+            .foregroundStyle(AppTheme.Status.warningColor)
+            .fixedSize(horizontal: false, vertical: true)
+    }
+
+    private func sectionTitle(_ title: String) -> some View {
