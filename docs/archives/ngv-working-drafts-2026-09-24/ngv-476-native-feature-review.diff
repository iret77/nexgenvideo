+            eurAmount: eur,
+            eurPerNativeUnit: 1 / 1.2,
+            exchangeRateDate: "2026-09-24",
+            pricingSource: "https://provider.example/pricing",
+            exchangeRateSource: "https://www.ecb.europa.eu/"
