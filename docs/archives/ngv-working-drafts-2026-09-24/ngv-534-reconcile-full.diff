+    func isMireloResumeActionAvailable(for asset: MediaAsset) -> Bool {
+        asset.mireloResumeAvailable
+            && !asset.isGenerating
+            && generationTasks[asset.id] == nil
+            && mireloReconciliationTasks[asset.id] == nil
