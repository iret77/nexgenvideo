+            operation: outcome.record.operation,
+            terminalResponse: outcome.terminalResponse
+        )
+        guard descriptors.count == 1,
+              let descriptor = descriptors.first,
+              descriptor.kind == .audio,
+              descriptor.remoteURL != nil else {
