+                    .onSubmit { commitRename() }
+                    .onExitCommand { isRenaming = false }
+            } else {
+                Text(folder.name)
+                    .interfaceFont(size: AppTheme.Typography.ui, weight: AppTheme.FontWeight.medium)
+                    .foregroundStyle(AppTheme.Text.primaryColor)
+                    .lineLimit(1)
