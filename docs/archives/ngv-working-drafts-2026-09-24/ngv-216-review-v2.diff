diff --git a/Sources/NexGenVideo/Agent/TreatmentBrainstorm/TreatmentBrainstormPromptCompiler.swift b/Sources/NexGenVideo/Agent/TreatmentBrainstorm/TreatmentBrainstormPromptCompiler.swift
new file mode 100644
