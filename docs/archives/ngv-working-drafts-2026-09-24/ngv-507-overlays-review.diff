+        host.layoutSubtreeIfNeeded()
+        var evidence: [String: Any] = [
+            "inspectorFrame": frameDescription(inspectorFrame),
+            "laneEvidence": laneEvidence,
+            "mode": mode,
+            "panelFrame": frameDescription(panelFrame),
